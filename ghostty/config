# Rex look for Ghostty 1.4
#
# Palette: Rex's own "Static Noir" (dark) and "Ivory Gallery" (light),
# extracted from Rex Beta.app. Typeface: JetBrains Mono, the font GoRex
# embeds and the one in its screenshot.
#
# Themes live in ~/.config/ghostty/themes/. Reload with Cmd+Shift+,

theme = dark:rex-static-noir,light:rex-ivory-gallery

# --- Window: seamless titlebar, Rex's pane inset, glass over the desktop ---
macos-titlebar-style = transparent
window-theme = auto
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-padding-color = background
background-opacity = 0.97
# Native macOS glass. Requires macOS 26+; use `background-blur = 20` on older.
background-blur = macos-glass-regular

# --- Type: GoRex uses JetBrains Mono at 11.6pt / 1.0 line height ---
font-family = JetBrains Mono
font-size = 12.5
adjust-cell-height = 6%
font-feature = +calt

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Splits: Rex's inactive-pane fade; divider follows the theme ---
unfocused-split-opacity = 0.9

# --- Keymap: Ghostty's macOS defaults already match Rex for split
# right/down, pane focus, zoom, command palette, and prompt jumps.
# These fill the remaining Rex bindings. ---
keybind = cmd+enter=new_split:auto
keybind = ctrl+cmd+f=toggle_fullscreen
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = alt+cmd+w=close_tab:this
keybind = shift+cmd+w=close_window

# --- Quality of life ---
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
